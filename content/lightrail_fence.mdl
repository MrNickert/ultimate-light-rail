-- Native industrial metal fence, uniformly scaled to 40% (1.3568m above ground).
-- Native panel length runs along Y; edge repetitions require local X.
-- Rotate 90 degrees around Z after scaling. Buried geometry supports uneven ground.
-- Visual boundary only: zero collision box, like the existing tram decals.
-- No transport metadata or native binary assets are included.
function data()
 local meshes={
  "::/assets/buildings/ind/fences/msh/fence_metal_4m_lod0_lod0.msh",
  "::/assets/buildings/ind/fences/msh/fence_metal_4m_lod1_lod1.msh",
