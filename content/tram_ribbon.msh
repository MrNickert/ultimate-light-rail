-- Original flat decal strip: 0.5m long. Offsets/counts are bytes.
function data()
 return {subMeshes={{indices={
  position={count=24,offset=192},uv0={count=24,offset=216},
  normal={count=24,offset=240},tangent={count=24,offset=264}}}},
  vertexAttr={position={count=48,numComp=3,offset=0},uv0={count=32,numComp=2,offset=48},
   normal={count=48,numComp=3,offset=80},tangent={count=64,numComp=4,offset=128}}}
end
